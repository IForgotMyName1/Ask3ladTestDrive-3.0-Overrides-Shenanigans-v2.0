cannon:b=yes
weaponType:i=-1
bUseHookAsRel:b=yes
emitColor:p3=1.0, 1.0, 0.0
emitI:r=10.0
emitR:r=3.0
emitTime:r=0.03
aimMinDist:r=10.0
aimMaxDist:r=4000.0
maxDeltaAngle:r=0.08
maxDeltaAngleVertical:r=0.08
shotFreq:r=0.15
reloadTime:r=8.0
traceFreq:i=4
bEnablePause:b=no
bullets:i=40
bulletsCluster:i=1

fxType:t="muzzle_ground_125mm"
fxGroundDust:t="dust_ground_wave_dirt_big"
fxGrassDust:t="dust_ground_wave_grass_big"
fxSandDust:t="dust_ground_wave_sand_big"
fxSnowDust:t="dust_ground_wave_snow_big"
fxConcreteDust:t="dust_ground_wave_asphalt_big"
fxWaterShockWave:t="dust_waterwave_big"
shouldCollideWithRendinsts:b=yes
fxMultipleSpawn:b=yes
isBulletBelt:b=no
notUseDefaultBulletInGui:b=yes

// Correct ground vehicle sounds (from the 125mm file that worked)
sound_path:t="tanks/weapon_tanks/cannons"
sound_pathStudio:t="ground/weapon/cannons"
sound:t="125mm_2a46_t72"
sound_inside:t="125mm_2a46_t72_interior"
sfxReloadBullet:t="grd_cannon_reload_T72"

bullet{
  // === Kinetic / Ballistic properties (APFSDS style) ===
  mass:r=8.5
  caliber:r=0.120
  speed:r=1650.0
  maxDistance:r=8000.0
  Cx:r=0.28

  bulletType:t="apds_fs_long_tank"
  normalizationPreset:t="ap"
  ricochetPreset:t="ap"
  groundRicochetPreset:t="ap_ground"
  secondaryShattersPreset:t="ap"
  slopeEffectPreset:t="ap"
  stabilityThreshold:r=0.05
  stabilityCaliberToArmorThreshold:r=5.0
  stabilityReductionAfterRicochet:r=0.3
  stabilityReductionAfterPenetration:r=0.15

  // Penetration (adjust to your taste)
  armorpower{
    ArmorPower0m:p2=480.0, 10.0
    ArmorPower500m:p2=460.0, 500.0
    ArmorPower1000m:p2=430.0, 1000.0
    ArmorPower2000m:p2=380.0, 2000.0
    ArmorPower3000m:p2=320.0, 3000.0
  }

  hitpower{
    HitPower0m:p2=1.0, 0.0
    HitPower1000m:p2=0.95, 1000.0
    HitPower2000m:p2=0.85, 2000.0
    HitPower3000m:p2=0.7, 3000.0
  }

  relativeVelHitShift:p2=300.0, 1000.0
  relativeVelArmorShift:p2=200.0, 1000.0
  hitPowerMult:r=1.2

  // === Big HESH-style explosion (from FV4005 idea) ===
  explodeTreshold:r=0.05
  explodeHitPower:r=3500.0
  explodeArmorPower:r=180.0
  explodeRadius:p2=7.0, 11.0
  rendinstDamageRadius:r=6.0
  explosionPatchRadius:r=4.5

  explosionEffect:t="bomb_expl_200kg"
  selfDestructionFx:t="explosion_air_selfexplosion_big"
  groundCollisionEffect:t="hit_106_132mm_dirt_he"
  ricochetEffect:t="hit_106_132mm_metal_ap"
  waterCollisionEffect:t="hit_106_132mm_water_he"
  waterRicochetEffect:t="hit_106_132mm_water_ap"
  groundRicochetEffect:t="hit_106_132mm_dirt_ap"

  // Optional proximity fuse (uncomment if you want airburst)
  /*
  hasProximityFuse:b=yes
  proximityFuse{
    radius:r=10.0
    armDistance:r=40.0
    detectAirUnits:b=yes
    detectGroundUnits:b=yes
    detectGround:b=yes
    detectShells:b=no
  }
  */

  visual{
    range_percent_of_ammo:p2=100.0, 0.0
    traceFreq:i=1
    tracer:t="100mmRed"
    trail:t="black"
  }

  fresnel:p3=0.23, 0.1, 2.0
  shellAnimation:t="video/shells_animations/apds_fs.ivf"
  bulletName:t="hybrid_apfsds_hesh"
}
