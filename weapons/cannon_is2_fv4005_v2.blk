  groundCollisionEffect:t="hit_106_132mm_dirt_he"
  ricochetEffect:t="hit_106_132mm_metal_ap"
  waterCollisionEffect:t="hit_106_132mm_water_he"

  armorpower{
    ArmorPower0m:p2=500.0, 10.0
    ArmorPower500m:p2=480.0, 500.0
    ArmorPower1000m:p2=450.0, 1000.0
    ArmorPower2000m:p2=390.0, 2000.0
    ArmorPower3000m:p2=320.0, 3000.0
