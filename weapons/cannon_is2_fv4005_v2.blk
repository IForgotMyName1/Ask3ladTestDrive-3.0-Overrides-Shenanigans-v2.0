  hitpower{
    HitPower0m:p2=1.0, 0.0
    HitPower1000m:p2=0.95, 1000.0
    HitPower2000m:p2=0.85, 2000.0
    HitPower3000m:p2=0.7, 3000.0
  }

  rocket{
    statType:t="hydra"
    caliber:r=0.152
    length:r=1.4
    mass:r=28.0
    massEnd:r=24.0
    CxK:r=1.8
    wingAreaMult:r=1.6
    distFromCmToStab:r=0.08

    useStartSpeed:b=yes
    startSpeed:r=80.0
    endSpeed:r=550.0
    maxDistance:r=7000.0
    minDistance:r=50.0
    operatedDist:r=7000.0
    operated:b=yes
    autoLeveling:b=yes
    autoAiming:b=yes
    maxLateralAcceleration:r=8.0
    maxDeltaAngle:r=0.04
    timeLife:r=20.0

    timeFire:r=4.0
    force:r=1200.0
    timeFire1:r=8.0
    force1:r=400.0

    explosiveType:t="torpex"
    explosiveMass:r=0.25
    normalizationPreset:t="ap"
    ricochetPreset:t="ap"
    groundRicochetPreset:t="ap_ground"
    secondaryShattersPreset:t="ap"
    bulletType:t="aphe_tank"

    explodeOnRendinst:b=yes
    explodeTreshold:r=0.35
    fuseDelayDist:r=1.5
    explosionEffect:t="hit_106_132mm_metal_he"
    selfDestructionFx:t="explosion_air_selfexplosion_big"
    groundCollisionEffect:t="hit_106_132mm_dirt_he"
    ricochetEffect:t="hit_106_132mm_metal_ap"
    waterCollisionEffect:t="hit_106_132mm_water_he"
