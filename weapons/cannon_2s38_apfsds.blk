// Plane gun not finished yet uses IForgotMyAirWeapon.blk

cannon:b=yes
weaponType:i=3
bUseHookAsRel:b=yes
emitColor:p3=1.0, 1.0, 0.0
emitI:r=10.0
emitR:r=3.0
emitTime:r=0.03
aimMinDist:r=0.1
aimMaxDist:r=5500.0
maxDeltaAngle:r=0.03
maxDeltaAngleVertical:r=0.03
shotFreq:r=9.16
shotFreqRndK:r=0.02
traceFreq:i=4
bEnablePause:b=no
bullets:i=-1
reloadTime:r=0.0
bulletsCluster:i=1
fxTypeEjector:t="smoke_gunpowder_ejector"
ejectionFxSpeedRange:p2=25.0, 45.0
fxType:t="muzzle_air_30mm"
fxGroundDust:t=""
fxGrassDust:t=""
fxSandDust:t=""
fxSnowDust:t=""
fxConcreteDust:t=""
fxWaterShockWave:t=""
fxMultipleSpawn:b=yes
shouldCollideWithRendinsts:b=yes
isBulletBelt:b=no
gunSound{
  path:t="sounds/guns"
  pathStudio:t="aircraft/weapon"
  outside:t="gsh_30_1_outside"
  cockpit:t="gsh_30_1_inside"
  ai:t="gsh_30_1_ai"
}

overheat{
  overheat:p2=1000000.0, 0.0
  overheat:p2=1200000.0, 0.0
}

bullet{
  bulletCount:i=5000
  mass:r=0.95
  caliber:r=0.057
  damageCaliber:r=0.016
  ballisticCaliber:r=0.016
  speed:r=1500.0
  Cx:r=0.8
  maxDistance:r=10000.0
  normalizationPreset:t="default"
  ricochetPreset:t="apds_fs_long"
  groundRicochetPreset:t="apds_fs_ground"
  secondaryShattersPreset:t="apds_fs_25_76mm"
  bulletType:t="apds_fs_long_tank"
  slopeEffectPreset:t="apds_fs_long"
  fresnel:p3=0.23, 0.1, 2.0
  shellAnimation:t="video/shells_animations/apfsds_modern.ivf"
  bulletName:t="57mm_3ubr_22"
  relativeVelHitShift:p2=300.0, 1000.0
  onHitChanceMultExplFuel:r=0.1
  relativeVelArmorShift:p2=200.0, 1000.0
  selfDestructionFx:t="explosion_air_selfexplosion_small"
  groundCollisionEffect:t="hit_39_58mm_dirt_ap"
  ricochetEffect:t="hit_28_38mm_metal_ap"
  waterCollisionEffect:t="hit_39_58mm_water"
  waterRicochetEffect:t="hit_28_38mm_water"
  groundRicochetEffect:t="hit_28_38mm_dirt_ap"
  explosionPatchRadius:r=0.7
  rendinstDamageRadius:r=0.0
  stability{
    precessionDamping:r=0.3
    ricochetAnglePrecessionFactor:r=1.0
    ricochetAngleOmegaFactor:r=0.25
    slopeToOmega:p4=1.0, 10.0, 0.0, 1.0
    angleLossStabilizationAfterRicochet:r=1.25
    penetrationReduction{
      pnt:p2=0.0, 1.0
      pnt:p2=2.0, 0.95
      pnt:p2=10.0, 0.5
      pnt:p2=21.0, 0.3
    }
  }
  DamageParts{
    body{
      hp:r=100.0
      armorClass:t="tank_structural_steel"
      armorThickness:r=15.0
    }
  }
  DamageEffects{
    part{
      name:t="body"
      onKill{
        destabilization:r=1.0
        impulse:r=0.005
      }
    }
  }
  tracePattern{
    caliber:r=10.0
    circleCount:i=2
    pointCount:i=6
  }
  hitpower{
    HitPower0m:p2=1.0, 1000.0
    HitPower10000m:p2=0.8, 10000.0
  }
  damage{
    kinetic{
      lanzOdermattMaterial:t="tungsten"
      lanzOdermattWorkingLength:r=245.0
      lanzOdermattDensity:r=17500.0
    }
  }
  visual{
    range_percent_of_ammo:p2=100.0, 0.0
    traceFreq:i=1
    tracer:t="30mmRed"
    trail:t="black"
  }
  collisions{
    default{
      fx:t="hit_39_58mm_dirt_ap"
      ricochetFx:t="hit_28_38mm_dirt_ap"
      pierceFx:t="hit_28_38mm_dirt_ap"
    }
    horLandMesh{
      fx:t="hit_39_58mm_dirt_ap"
