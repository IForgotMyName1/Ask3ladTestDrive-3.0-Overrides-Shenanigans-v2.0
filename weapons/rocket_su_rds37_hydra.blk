bullet{
  normalizationPreset:t="heat"
  ricochetPreset:t="he"
  groundRicochetPreset:t="he_ground"
  secondaryShattersPreset:t="ap"
  stabilityThreshold:r=0.5
  stabilityCaliberToArmorThreshold:r=5.0
  stabilityReductionAfterRicochet:r=0.3
  stabilityReductionAfterPenetration:r=0.15
  bulletType:t="heat_grenade_tank"
  explodeOnRendinst:b=yes
  fresnel:p3=0.23, 0.1, 2.0
  shellAnimation:t="video/shells_animations/heat_fs.ivf"
  bulletName:t="su_rds4"
  mass:r=24.0
  caliber:r=0.829
  sound_path:t="tanks/weapon_tanks/rockets"
  sound_pathStudio:t="ground/weapon/rockets"
  sound:t="75mm_m3"
  sound_inside:t="75mm_m3_interior"
  recoilMultiplier:r=0.0

  stabilityRicochetModifier{
    mod1:p2=0.0, 0.5
    mod2:p2=15.0, 0.7
    mod3:p2=30.0, 0.99
  }

  DamageParts{

    body{
      hp:r=5.0
      armorClass:t="tank_structural_steel"
      armorThickness:r=1.0
    }
  }

  DamageEffects{

    part{
      name:t="body"

      onHit{
        break_fuse:r=1.0
      }

      onKill{
        destruction:r=1.0
      }
    }
  }

  pressureDamage{
    damageType:t="pressure"
  }

  rocket{
    statType:t=""
    caliber:r=0.07
    length:r=1.15
    WdK:p3=0.1, 0.1, 0.1
    CxK:r=1.5
    distFromCmToStab:r=0.005
    mass:r=24.0
    massEnd:r=24.0
    timeFire:r=1.1
    force:r=6064.0
    thrustDeviation:r=0.01
    useStartSpeed:b=yes
    startSpeed:r=0.0
    maxSpeed:r=1339.0
    endSpeed:r=1339.0
    maxDistance:r=6200.0
    minDistance:r=30.0
    maxDeltaAngle:r=0.03
    normalizationPreset:t="heat"
    ricochetPreset:t="he"
    groundRicochetPreset:t="he_ground"
    secondaryShattersPreset:t="ap"
    stabilityThreshold:r=0.5
    stabilityCaliberToArmorThreshold:r=5.0
    stabilityReductionAfterRicochet:r=0.3
    stabilityReductionAfterPenetration:r=0.15
    bulletType:t="heat_grenade_tank"
    explodeOnRendinst:b=yes
    fresnel:p3=0.23, 0.1, 2.0
    shellAnimation:t="video/shells_animations/heat_fs.ivf"
    dragCx:r=0.027

    // ---------- RDS-37 NUKE (fields copied from vanilla su_rds37 bomb) ----------
    yield:r=1600.0
    splashFallBySquare:b=yes
    hasProximityFuse:b=yes
    iconType:t="bombs_heavy_nuke"
    // fallback conventional blast in case 'yield' is ignored on rockets
    explosiveType:t="tnt"
    explosiveMass:r=100.0
    explodeTreshold:r=50.0

    proximityFuse{
      timeOut:r=20.0
      radius:r=125.0
      detectAirUnits:b=no
      detectGroundUnits:b=no
      detectGround:b=yes
    }

    // original Hydra effects (unchanged from your first file)
    selfDestructionFx:t="hit_81_132mm_heat"
    explosionEffect:t="hit_81_132mm_heat"
    groundCollisionEffect:t="hit_81_105mm_dirt_he"
    ricochetEffect:t="hit_81_105mm_metal_ap"
    waterCollisionEffect:t="hit_81_105mm_water_he"
    waterRicochetEffect:t="hit_81_105mm_water_ap"
    groundRicochetEffect:t="hit_81_105mm_dirt_ap"
    explosionPatchRadius:r=3.0
    rendinstDamageRadius:r=6.0
    explosionOffset:r=0.05
    fuseDelayDist:r=0.0
    distanceFuse:b=no
    // ---------------------------------------------------------------------------

    visualShattersWaterOffset:r=1.2
    visualShattersGroundOffset:r=1.2
    fireEffect:t="fires_exhaust_jet_early_tiny"
    smokeEffect:t="smoke_rocket_tail_dark_multiple"
    smokeEffect2:t=""
    hazeEffect:t="haze_missile"
    endSmokeViscosity:r=0.05
    effectOffset:p3=-1.2, 0.0, 0.0
